# Copy to .env and fill in. The VITE_* vars are embedded at build time.
# Supabase
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""

# Server-side only (never exposed to client)
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# ===== Edge Function secrets =====
# Configure these in Supabase Dashboard → Edge Functions → Secrets (NOT here)
# SUPABASE_SERVICE_ROLE_KEY=
# PERPLEXITY_API_KEY=
# LOVABLE_API_KEY=
# SCHEDULER_SECRET=  (also: ALTER DATABASE postgres SET app.scheduler_secret = '<same>')
